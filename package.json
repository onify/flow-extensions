{
  "name": "@onify/flow-extensions",
  "version": "10.0.1",
  "description": "Onify Flow extensions",
  "type": "module",
  "module": "src/index.js",
  "main": "dist/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.js"
    },
    "./FlowScripts": {
      "types": "./types/index.d.ts",
      "require": "./dist/FlowScripts.js",
      "import": "./dist/FlowScripts.js"
    }
  },
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run types && npm run dist && texample",
    "lint": "eslint . --cache && prettier . --check --cache",
    "prepare": "npm run dist && npm run types",
    "dist": "babel src -d dist && babel test/helpers/FlowScripts.js -d dist",
    "types": "dts-buddy types/index.d.ts -m @onify/flow-extensions:src/index.js -m @onify/flow-extensions/FlowScripts:test/helpers/FlowScripts.js",
    "test:lcov": "c8 -r lcov mocha && npm run lint",
    "cov:html": "c8 mocha && c8 report --reporter html"
  },
  "keywords": [
    "onify",
    "flow",
    "bpmn",
    "bpmn-engine",
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/onify/flow-extensions.git"
  },
  "author": {
    "name": "Onify",
    "url": "https://github.com/onify"
  },
  "license": "MIT",
  "devDependencies": {
    "@aircall/expression-parser": "^1.0.4",
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/register": "^7.23.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "bpmn-elements": "^18.0.22",
    "bpmn-elements-17": "npm:bpmn-elements@^17",
    "bpmn-elements-8-1": "npm:bpmn-elements@8.1",
    "bpmn-engine": "^26.0.0",
    "bpmn-engine-14": "npm:bpmn-engine@^14",
    "bpmn-engine-25": "npm:bpmn-engine@^25",
    "bpmn-moddle": "^9.0.1",
    "c8": "^12.0.0",
    "camunda-bpmn-moddle": "^7.0.1",
    "chai": "^6.2.1",
    "chronokinesis": "^8.0.0",
    "debug": "^4.3.4",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "mocha": "^11.0.1",
    "mocha-cakes-2": "^3.3.0",
    "moddle-context-serializer": "^6.0.1",
    "prettier": "^3.2.4",
    "texample": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@0dep/piso": ">=2",
    "bpmn-elements": ">=17",
    "croner": ">=9.0.0"
  },
  "files": [
    "src",
    "dist",
    "types",
    "FlowScripts.d.ts"
  ],
  "c8": {
    "exclude": [
      "dist",
      "test",
      "babel.config.cjs"
    ]
  }
}
